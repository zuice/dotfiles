configuration {
    modi: "drun";
    font: "FiraCode Nerd Font Mono 13";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun: " Apps ";
}

@theme "/dev/null"

* {
    bg: #1a1b26f2;
    bg-alt: #24283b;
    fg: #c0caf5;
    fg-alt: #a9b1d6;
    fg-dim: #565f89;
    accent: #7dcfff;
    border: #3b4261;
    selected: #292e42;
    urgent: #f7768e;

    background-color: transparent;
    text-color: @fg;
    border-color: @border;

    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 520px;
    border-radius: 16px;
    padding: 20px;
    background-color: @bg;
    border: 1px;
    border-color: @border;
}

inputbar {
    padding: 14px 16px;
    border-radius: 12px;
    background-color: @bg-alt;
    border: 1px;
    border-color: @border;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    margin: 0 10px 0 0;
}

entry {
    text-color: @fg;
    placeholder-color: @fg-dim;
    placeholder: "Search...";
}

listview {
    margin: 14px 0 0 0;
    lines: 8;
    columns: 1;
    fixed-height: false;
    border-radius: 12px;
}

element {
    padding: 10px 12px;
    border-radius: 10px;
    spacing: 10px;
}

element-icon {
    size: 22px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: @fg;
}

element selected {
    background-color: @selected;
}

element selected element-text {
    text-color: @accent;
}

element urgent {
    text-color: @urgent;
}
