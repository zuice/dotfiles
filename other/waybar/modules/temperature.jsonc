{
	"temperature": {
		"hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
		"critical-threshold": 85,
		"interval": 5,
		"format": "<span color='#ff9e64'>{icon}</span> {temperatureC}°",
		"format-icons": [
			"󱃃",
			"󰔏",
			"󱃂"
		],
		"states": {
			"warning": 65,
			"critical": 80
		},
		"min-length": 7,
		"max-length": 7,
		"tooltip-format": "CPU Temp: {temperatureC}°C / {temperatureF}°F",
		"tooltip": true
	}
}
