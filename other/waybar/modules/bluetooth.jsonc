{
	"bluetooth": {
		"format": "󰂯",
		"format-disabled": "󰂲",
		"format-off": "󰂲",
		"format-on": "󰂰",
		"format-connected": "󰂱 {device_alias}",
		"format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
		"min-length": 2,
		"max-length": 15,
		"on-click": "kitty -e ~/.config/waybar/scripts/bluetooth.sh",
		"on-click-right": "bluetoothctl power off && notify-send 'Bluetooth Off' -i 'network-bluetooth-inactive' -h string:x-canonical-private-synchronous:bluetooth",
		"tooltip-format": "Status: {status}",
		"tooltip-format-connected": "Device: {device_alias}\nAddress: {device_address}",
		"tooltip-format-connected-battery": "Device: {device_alias}\nBattery: {device_battery_percentage}%\nAddress: {device_address}"
	}
}
