{
	"group/pulseaudio": {
		"orientation": "horizontal",
		"modules": [
			"pulseaudio#output",
			"pulseaudio#input"
		]
	},

	"pulseaudio#output": {
		"format": "<span color='#e0af68'>{icon}</span> {volume}%",
		"format-muted": "<span color='#414868'>󰝟</span> {volume}%",
		"format-icons": {
			"default": ["󰕿", "󰖀", "󰕾"],
			"default-muted": "󰝟",
			"headphone": "󰋋",
			"headphone-muted": "󰟎",
			"headset": "󰋎",
			"headset-muted": "󰋐"
		},
		"min-length": 7,
		"max-length": 7,
		"on-click": "pavucontrol",
		"on-click-right": "~/.config/waybar/scripts/volume.sh output mute",
		"on-scroll-up": "~/.config/waybar/scripts/volume.sh output raise",
		"on-scroll-down": "~/.config/waybar/scripts/volume.sh output lower",
		"tooltip-format": "Output: {desc}"
	},

	"pulseaudio#input": {
		"format": "{format_source}",
		"format-source": "<span color='#e0af68'>󰍬</span>",
		"format-source-muted": "<span color='#414868'>󰍭</span>",
		"min-length": 2,
		"max-length": 2,
		"on-click": "~/.config/waybar/scripts/volume.sh input mute",
		"on-scroll-up": "~/.config/waybar/scripts/volume.sh input raise",
		"on-scroll-down": "~/.config/waybar/scripts/volume.sh input lower",
		"tooltip-format": "Input: {desc}"
	}
}
