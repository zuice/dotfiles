{
	"memory": {
		"interval": 5,
		"format": "<span color='#bb9af7'>󰘚</span> {percentage}%",
		"states": {
			"warning": 70,
			"critical": 85
		},
		"min-length": 6,
		"max-length": 6,
		"on-click": "ghostty -e sh -c 'command -v btop >/dev/null && exec btop; exec top'",
		"tooltip-format": "Used: {used:0.1f} / {total:0.1f} GB\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GB\nFree: {avail:0.1f} GB",
		"tooltip": true
	}
}
