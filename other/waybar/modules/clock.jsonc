{
	"clock": {
		"interval": 60,
		"format": "{:%a %b %d  %I:%M %p}",
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"weeks-pos": "right",
			"on-scroll": 1
		},
		"actions": {
			"on-click": "mode",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	}
}
