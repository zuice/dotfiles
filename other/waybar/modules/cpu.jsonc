{
	"cpu": {
		"interval": 5,
		"format": "<span color='#7aa2f7'>󰍛</span> {usage}%",
		"states": {
			"warning": 60,
			"critical": 80
		},
		"min-length": 6,
		"max-length": 6,
		"on-click": "ghostty -e sh -c 'command -v btop >/dev/null && exec btop; exec top'",
		"tooltip-format": "CPU Usage: {usage}%",
		"tooltip": true
	}
}
